// Containers & OOP Keywords Examples
// Keywords covered: container, property, extends, new, action, implements, interface

display "Container examples"

create container Animal:
    property name: Text
    property age_years: Number

    action make_sound:
        display "Some sound"
    end
end

create new Animal as pet:
    name is "Buddy"
    age_years is 3
end

display "Pet name: " with pet.name

create container Vehicle:
    property brand: Text
    property year_made: Number

    action get_info: Text
        return brand with " " with year_made
    end
end

create new Vehicle as car:
    brand is "Toyota"
    year_made is 2024
end

store car_info as car.get_info()
display "Car: " with car_info

display "Container examples complete"
