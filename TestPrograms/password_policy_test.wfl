// Explicit policy and upgrade journey through the release CLI and typechecker.
describe "Password hash policy maintenance":
    test "successful login can upgrade a hash without changing the password":
        store previous_policy as password_hash_policy of 19456 and 2 and 1
        store current_policy as password_hash_policy of 32768 and 3 and 1
        store password as "maintained account password"
        store stored as hash_password_with_policy of password and previous_policy
        store login_ok as verify_password of password and stored
        expect login_ok to be yes
        store outdated as password_needs_rehash of stored and current_policy
        expect outdated to be yes
        change stored to hash_password_with_policy of password and current_policy
        store fresh as password_needs_rehash of stored and current_policy
        expect fresh to be no
        store still_valid as verify_password of password and stored
        expect still_valid to be yes
        store wrong as verify_password of "incorrect" and stored
        expect wrong to be no
    end test

    test "invalid policies and corrupt metadata raise errors":
        store invalid_policy as no
        try:
            store rejected as password_hash_policy of 1 and 2 and 1
        when error:
            change invalid_policy to yes
        end try
        expect invalid_policy to be yes

        store policy as password_hash_policy of 19456 and 2 and 1
        store invalid_hash as no
        try:
            store rejected_hash as password_needs_rehash of "corrupt" and policy
        when error:
            change invalid_hash to yes
        end try
        expect invalid_hash to be yes
    end test

    test "the original single argument hash remains supported":
        store stored as hash_password of "existing account"
        store policy as password_hash_policy of 19456 and 2 and 1
        store outdated as password_needs_rehash of stored and policy
        expect outdated to be no
    end test
end describe
