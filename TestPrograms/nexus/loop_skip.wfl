// Converted from legacy probe `Nexus/test_skip_loop.wfl` (repository hygiene
// migration): `skip` jumps to the next loop iteration. The legacy probe's
// even-check used `(n divided by 2) times 2`, which is an identity under
// WFL's exact (non-truncating) division — see even_inline_precedence.wfl —
// so this conversion uses `modulo` for the parity test.
store total_odds as 0
store count2 as 0
repeat while count2 is less than 5:
    change count2 to count2 plus 1
    check if count2 modulo 2 is equal to 0:
        skip
    end check
    change total_odds to total_odds plus count2
end repeat

describe "loop skip":
    test "skip bypasses even numbers, summing 1+3+5":
        expect total_odds to equal 9
    end test
end describe
