// Count-loop steps are always checked
//
// A count loop's step is a distance: `to` counts up, `down to` counts down,
// and the step says how far each trip moves. The step used to be checked only
// when the loop would run, so `count from 5 to 1 by -1` — which reads like a
// countdown — silently ran zero times, and so did the mirror
// `count from 1 down to 5 by -1`. Every step is now checked, and a negative
// step's error names the loop the program most likely meant.

describe "Count loop steps":

    test "a negative step on a countdown range is reported":
        store ran as 0
        store reported as ""
        try:
            count from 5 to 1 by -1:
                change ran to ran plus 1
            end count
        when error:
            change reported to error_message
        end try
        expect ran to equal 0
        expect reported to contain "count from 5 down to 1"
    end test

    test "any numbers are reported, not just 5 to 1":
        store reported as ""
        try:
            count from 12 to 2 by -2:
                display "never"
            end count
        when error:
            change reported to error_message
        end try
        expect reported to contain "count from 12 down to 2 by 2"
    end test

    test "the mirror direction is reported too":
        store ran as 0
        store reported as ""
        try:
            count from 1 down to 5 by -1:
                change ran to ran plus 1
            end count
        when error:
            change reported to error_message
        end try
        expect ran to equal 0
        expect reported to contain "count from 1 to 5"
    end test

    test "a zero step is reported even when the range is empty":
        store reported as ""
        try:
            count from 5 to 1 by 0:
                display "never"
            end count
        when error:
            change reported to error_message
        end try
        expect reported to contain "A step of 0 never moves the counter"
    end test

    test "an empty range with a positive step still runs zero times":
        store items as []
        store ran as 0
        count from 1 to length of items:
            change ran to ran plus 1
        end count
        count from 5 to 1:
            change ran to ran plus 1
        end count
        count from 1 down to 5 by 2:
            change ran to ran plus 1
        end count
        expect ran to equal 0
    end test

    test "down to still counts down by a positive step":
        store total as 0
        count from 5 down to 1 by 2:
            change total to total plus count
        end count
        expect total to equal 9
    end test

end describe
