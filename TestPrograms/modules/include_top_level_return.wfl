// Converted from legacy root probe `test_main_fix.wfl` (repository hygiene
// migration): a top-level `return` inside an included file must end only the
// included module, not the including program, and the module's exports must
// remain visible afterwards.
store before_marker as "before"
include from "../../tests/fixtures/modules/export_and_top_level_return.wfl"
store after_marker as "after include"

describe "include with top-level return":
    test "execution continues after the included file returns":
        expect before_marker to equal "before"
        expect after_marker to equal "after include"
    end test

    test "exported constant from the included file is visible":
        expect API_VERSION to equal "2.0.1"
    end test
end describe
