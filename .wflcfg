timeout_seconds = 60
logging_enabled = false
# Off in the repository: crash reports and execution logs are written next to
# the program being run, which litters the checkout during test suites
# (REPOSITORY_HYGIENE.md §5 — the working-tree CI gate fails on droppings).
# The packaged installer config enables debug reports for end users.
debug_report_enabled = false
execution_logging = false
log_level = info

# Web server settings
# The IP address the web server will bind to (default: 127.0.0.1)
# Use 0.0.0.0 to listen on all interfaces
web_server_bind_address = 127.0.0.1

# Default TLS certificate/key (PEM) for `listen ... secured` statements
# that do not name their own files (no default; uncomment to use)
# web_server_tls_cert_file = /etc/wfl/tls/cert.pem
# web_server_tls_key_file = /etc/wfl/tls/key.pem
