# VS Code extension packages
*.vsix

# =============================================================================
# IDE and Editor files
# =============================================================================

# Visual Studio Code
# (`.vscode/*` not `.vscode/`: git cannot re-include files below an ignored
# directory, so the negations only work with the contents-glob form)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# =============================================================================
# OS-specific files
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
# The macOS Finder icon file is literally "Icon\r". The old `Icon?` glob also
# swallowed the tracked `icons/` directory on case-insensitive filesystems.
Icon[\r]
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

